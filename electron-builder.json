{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.superanimator.studio.desktop",
  "productName": "Super Animator Studio",
  "copyright": "Super Animator Studio Offline",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon.ico",
    "public/pwa-512x512.png",
    "package.json"
  ],
  "win": {
    "icon": "public/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "portable": {
    "artifactName": "Super-Animator-Studio-Portable.exe",
    "requestExecutionLevel": "user"
  },
  "nsis": {
    "artifactName": "Super-Animator-Studio-Setup.exe",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "mac": {
    "icon": "public/pwa-512x512.png",
    "category": "public.app-category.video",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "extendInfo": {
      "LSMinimumSystemVersion": "10.15.0"
    },
    "target": [
      {
        "target": "dmg",
        "arch": ["x64"]
      },
      {
        "target": "zip",
        "arch": ["x64"]
      }
    ]
  },
  "dmg": {
    "artifactName": "Super-Animator-Studio-macOS-10.15-x64.dmg",
    "title": "Super Animator Studio (macOS 10.15+)",
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  }
}
